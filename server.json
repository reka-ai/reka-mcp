{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.reka/mcp",
  "title": "Reka",
  "description": "Understand your videos with Reka AI — search, ask questions, and extract insights.",
  "version": "0.1.8",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.reka.ai/mcp",
      "headers": [
        {
          "name": "X-Reka-API-Key",
          "description": "Your Reka API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "reka-mcp",
      "version": "0.1.8",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
